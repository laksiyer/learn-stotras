# Media -> Git LFS
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Audacity project files: treat as binary (and keep them out via .gitignore)
*.aup3 -text
*.aup3-wal -text
*.aup3-shm -text
# Website/text files: normal Git behavior (explicitly ensure NOT LFS)
*.html text
*.js text
*.css text
*.json text
*.tsv text
*.mp3 text !filter !merge !diff
